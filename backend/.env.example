# Copy to backend/.env (gitignored) for local `supabase functions serve --env-file backend/.env`
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zhipu (智谱) BigModel API -- OpenAI-compatible endpoint, https://open.bigmodel.cn
ZHIPU_API_KEY=
# glm-4-flash is free; glm-4.6 is stronger but needs a funded account
CHAT_MODEL_ID=glm-4-flash

# 讯飞 (iFlytek) streaming ASR -- console.xfyun.cn, "语音听写"(流式版) app.
# Used by the xfyun-auth function to mint signed WebSocket URLs; the client
# never sees these values directly.
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
